# GitHub Personal Access Token (classic or fine-grained)
# Needed for 5,000 req/hr rate limit. Without it, anonymous limit is 60/hr.
GITHUB_TOKEN=

# Local Supabase (from `supabase start` → API URL + service_role key)
# Or your cloud project URL + service role key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=

# Public site origin (Open Graph / absolute URLs). Optional locally;
# required on Vercel (production + preview). Pin to the stable alias
# (e.g. https://repolens.vercel.app), not a per-deployment hostname.
NEXT_PUBLIC_SITE_URL=

# Upstash Redis — per-IP rate limiting + distributed build lock + global
# GitHub budget. Leave blank locally (no-op). Required on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (optional in local; leave blank to skip)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Sourcemap upload (CI/Vercel builds). Without org/project, upload no-ops.
SENTRY_ORG=
SENTRY_PROJECT=

# Dev harness only — set to 1 for phase timings in `bun run timeline`.
# REPOLENS_TIMING=1
